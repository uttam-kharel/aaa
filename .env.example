[TEMPLATE]
# ==========================
# Application Configuration
# ==========================

APP_NAME="Shubham International Hospital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ==========================
# Security & Optimization
# ==========================

BCRYPT_ROUNDS=12
APP_MAINTENANCE_DRIVER=file

# ==========================
# Logging
# ==========================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ==========================
# Database
# ==========================

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ==========================
# Cache, Session, & Queue
# ==========================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ==========================
# Frontend (Vite)
# ==========================

VITE_APP_NAME="${APP_NAME}"

# ==========================
# Vercel (Production) — set these in Vercel Dashboard > Settings > Environment Variables
# ==========================
# Not needed for local development. Values below are the placeholders to add in Vercel.

# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-app.vercel.app
# APP_KEY=<run: php artisan key:generate --show>

# Database: Vercel Postgres (Neon). Set DB_URL to the NON_POOLING connection string
# (POSTGRES_URL_NON_POOLING) so migrations and sessions work reliably.
# DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require

# Sessions / cache / queue are stored in Postgres so they survive serverless restarts.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Image & file storage: Vercel Blob through Laravel's built-in S3 disk.
# Vercel Blob is S3-compatible — copy these values from your Blob store in the
# Vercel dashboard (Storage > your Blob store > Settings > S3 API):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=<from Blob store S3 API>
# AWS_SECRET_ACCESS_KEY=<from Blob store S3 API>
# AWS_BUCKET=<your Blob store ID>
# AWS_ENDPOINT=https://<store-id>.blob.vercel-storage.com
# AWS_URL=https://<store-id>.public.blob.vercel-storage.com   (so Storage::url() is correct)
# AWS_DEFAULT_REGION=us-east-1
# AWS_USE_PATH_STYLE_ENDPOINT=true
