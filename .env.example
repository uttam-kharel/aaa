# .env.example — the template for local development.
# Copy it to .env locally:  cp .env.example .env
# The Vercel Production values are listed at the bottom — set THOSE in the
# Vercel dashboard (Settings > Environment Variables), never in a committed file.
[TEMPLATE]

# ==========================
# Application Configuration
# ==========================

APP_NAME="Shubham International Hospital"
# ^ Display name used in emails, page titles, and notifications.

APP_ENV=local
# ^ local / staging / production. Vercel overrides this to production.

APP_KEY=
# ^ Laravel's encryption key (base64:...). Generate with:
#   php artisan key:generate --show

APP_DEBUG=true
# ^ Shows stack traces + error details. MUST be false in production.

APP_TIMEZONE=UTC
# ^ Default timezone for dates/times in the app.

APP_URL=http://localhost
# ^ The site's base URL. In production, Vercel overrides this with the real domain.

APP_LOCALE=en
# ^ Default app language.

APP_FALLBACK_LOCALE=en
# ^ Language used when the requested one has no translations.

APP_FAKER_LOCALE=en_US
# ^ Locale used by factories/Faker when generating fake data.

# ==========================
# Security & Optimization
# ==========================

BCRYPT_ROUNDS=12
# ^ Cost factor for password hashing — 12 is Laravel's recommended default.

APP_MAINTENANCE_DRIVER=file
# ^ Where the "down for maintenance" flag lives when running `php artisan down`.

# ==========================
# Logging
# ==========================

LOG_CHANNEL=stack
# ^ Aggregate logger; "stack" forwards messages to the channels below.

LOG_STACK=single
# ^ Underlying channel(s) — "single" writes one laravel.log file.

LOG_LEVEL=debug
# ^ Minimum severity recorded (debug = most verbose; production uses warning).

LOG_DEPRECATIONS_CHANNEL=null
# ^ Where PHP deprecation warnings go (null = discard them).

# ==========================
# Database
# ==========================

DB_CONNECTION=sqlite
# ^ Local development uses the sqlite file: database/database.sqlite.
#   Production (Vercel) switches to pgsql — see the Vercel section below.

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# ^ Optional overrides if you connect to a real MySQL/Postgres server locally.

# ==========================
# Cache, Session, & Queue
# ==========================

SESSION_DRIVER=database
# ^ Sessions live in the `sessions` table — survives restarts.

SESSION_LIFETIME=120
# ^ Session lifetime in minutes.

SESSION_ENCRYPT=true
# ^ Encrypt session data at rest.

# ==========================
# Frontend (Vite)
# ==========================

VITE_APP_NAME="${APP_NAME}"
# ^ Exposed to the browser bundle via import.meta.env.VITE_APP_NAME.

# ==========================
# Vercel (Production) — set these in Vercel Dashboard > Settings > Environment Variables
# ==========================
# Not needed for local development. Values below are the placeholders to add in Vercel.

# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-app.vercel.app
# APP_KEY=<run: php artisan key:generate --show>

# Database: Vercel Postgres (Neon). Set DB_URL to the NON_POOLING connection string
# (POSTGRES_URL_NON_POOLING) so migrations and sessions work reliably.
# DB_CONNECTION=pgsql
DB_URL=
# ^ Used by CI migrations and by the running app. Use POSTGRES_URL_NON_POOLING.

DB_SSLMODE=require
# ^ Postgres over TLS — required by Vercel/Neon.

# Sessions / cache / queue are stored in Postgres so they survive serverless restarts.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
# ^ NEVER use file-based drivers in production — the container filesystem is
#   ephemeral and not shared across instances.

# Image & file storage: Vercel Blob through Laravel's built-in S3 disk.
# Vercel Blob is S3-compatible — copy these values from your Blob store in the
# Vercel dashboard (Storage > your Blob store > Settings > S3 API):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=<from Blob store S3 API>
# AWS_SECRET_ACCESS_KEY=<from Blob store S3 API>
# AWS_BUCKET=<your Blob store ID>
# AWS_ENDPOINT=https://<store-id>.blob.vercel-storage.com
# AWS_URL=https://<store-id>.public.blob.vercel-storage.com   (so Storage::url() is correct)
# AWS_DEFAULT_REGION=us-east-1
# AWS_USE_PATH_STYLE_ENDPOINT=true
# ^ use_path_style is REQUIRED — each Blob store lives on its own subdomain.
